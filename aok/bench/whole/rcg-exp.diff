+/*
+ * EXPERIMENT (not for upstream): RCG_EXP=mem gives gadgets only to
+ * instructions that access guest memory; RCG_EXP=nocond gives none to Jcc,
+ * SETcc and CMOVcc. Anything else, or unset, is structure A as it is.
+ */
+static int rcg_exp(void)
+{
+    static int mode = -1;
+
+    if (mode < 0) {
+        const char *e = getenv("RCG_EXP");
+
+        mode = !e ? 0 : !strcmp(e, "mem") ? 1 : !strcmp(e, "nocond") ? 2 : 0;
+    }
+    return mode;
+}
