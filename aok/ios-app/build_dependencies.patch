+    fixup_all
+    exit 0
+fi
 echo "${GREEN}Starting build for ${PLATFORM_FAMILY_NAME} ${ARCH} [${NCPU} jobs]${NC}"
 
 if [ ! -f "$BUILD_DIR/BUILD_SUCCESS" ]; then
